# Base de données PostgreSQL (Prisma). Utiliser une URL prisma:// si Accelerate est activé.
DATABASE_URL=

# Clerk (authentification)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Stripe (paiement + catalogue produit synchronisé via webhook)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (emails transactionnels / newsletter)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# URL publique de l'application (utilisée pour le SEO, JSON-LD, liens de partage)
NEXT_PUBLIC_APP_URL=
